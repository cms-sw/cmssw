#!/usr/bin/env python3

"""
This script splits an HLT configuration into local and remote processes
by offloading selected modules or sequences.

This tool analyzes data dependencies between CMSSW modules and generates
the derived configuration files:
    - one *local* process config
    - one or multiple *remote* process configs

Modules specified for offloading will be moved to the remote processes.
If multiple remote processes are needed, individual parameters should
be separated by ":".
Any required data products are automatically identified and forwarded
between processes unless the producing module is explicitly marked as
shared.
"""

import sys

from FWCore.ParameterSet.processFromFile import processFromFile
from HeterogeneousCore.MPICore.configuration_splitter.multiple_remotes_option_parser import parse_mpi_style_args
from HeterogeneousCore.MPICore.configuration_splitter.process_dump import ProcessDump
from HeterogeneousCore.MPICore.configuration_splitter.split_remote import split_remote

def main():
    configs = parse_mpi_style_args(sys.argv[1:])

    if configs[0].verbose:
        for i, cfg in enumerate(configs):
            print(f"\n=== Process {i} ===")
            print(cfg)

    local_process = processFromFile(str(configs[0].config))

    # -- Get product names and their dependency graph from the framework --

    if configs[0].verbose:
        if configs[0].reuse_dumps:
            print("Trying to read the product names and dependency graph from existing files...")
        else:
            print("Launching cmsRun to dump the product names and dependency graph of the process...")

    cpp_names_of_the_products, dependency_graph = ProcessDump(local_process, reuse=configs[0].reuse_dumps).run()

    if configs[0].verbose:
        print("Got the product names and the dependency graph")

    for process_args in configs:
        remote_process = split_remote(local_process, process_args, cpp_names_of_the_products, dependency_graph)
        process_args.output_remote.parent.mkdir(parents=True, exist_ok=True)
        process_args.output_remote.write_text(remote_process.dumpPython())

    configs[0].output_local.parent.mkdir(parents=True, exist_ok=True)
    configs[0].output_local.write_text(local_process.dumpPython())


if __name__ == "__main__":
    main()
