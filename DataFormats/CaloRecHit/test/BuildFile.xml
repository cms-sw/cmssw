<bin name="testCaloCluster" file="testRunner.cpp,testCaloCluster.cppunit.cc">
  <use name="DataFormats/CaloRecHit"/>
  <use name="DataFormats/Math"/>
  <use name="cppunit"/>
</bin>

<iftool name="cuda-gcc-support">
  <bin name="test_calo_rechit" file="test_calo_rechit.cu">
    <use name="DataFormats/CaloRecHit"/>
    <use name="DataFormats/DetId"/>
    <use name="HeterogeneousCore/CUDAUtilities"/>
    <use name="cuda"/>
  </bin>
</iftool>

<bin name="TestCaloClusterSoA" file="alpaka/TestCaloClusterSoA.dev.cc">
  <use name="catch2"/>
  <use name="eigen"/>
  <use name="DataFormats/CaloRecHit"/>
  <use name="DataFormats/Portable"/>
  <use name="FWCore/Utilities"/>
  <use name="HeterogeneousCore/AlpakaInterface"/>
  <flags ALPAKA_BACKENDS="serial"/>
</bin>

<library name="testDataFormatsCaloClusterSoAIO" file="TestWriteCaloClusterSoA.cc,TestReadCaloClusterSoA.cc">
  <flags EDM_PLUGIN="1"/>
  <use name="eigen"/>
  <use name="DataFormats/CaloRecHit"/>
  <use name="FWCore/Framework"/>
  <use name="FWCore/ParameterSet"/>
  <use name="FWCore/Utilities"/>
  <use name="HeterogeneousCore/AlpakaInterface"/>
</library>

<test name="TestCaloClusterSoAWriteRead" command="testCaloClusterSoAWriteRead.sh"/>
