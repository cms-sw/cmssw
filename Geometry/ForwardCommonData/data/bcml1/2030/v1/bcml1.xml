<?xml version="1.0"?>
<DDDefinition>
  <!--BCML1 source: FLUKA v6630.inp; seven source regions at +z, z=284.8 to 287.2 cm.-->
  <!--Construction hierarchy: +x unit (containing all +y/-y) -> rotated -x unit -> +z assembly.-->
  <!--Full +z assembly optionally rotated to -z in companion placement template.-->
  <!--Rz180 used for -x to preserve asymmetric PCB/diamond positions in z; Ry180 would reverse z.-->
  <!--Material replacement: carbon-fiber shell -> air cavity -> FR4/diamond daughters.-->

<SolidSection label="BCML1">
  <Box name="BCML1" dx="4.6*cm" dy="9*cm" dz="1.2*cm" />
  <Box name="BCML1_PosXUnitSolid" dx="1.55*cm" dy="9*cm" dz="1.2*cm" />
  <Box name="BCML1_SideShellBase" dx="1.45*cm" dy="4.4*cm" dz="1.2*cm" />
