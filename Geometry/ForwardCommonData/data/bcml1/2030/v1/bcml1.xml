  <Tubs name="BCML1_Cut_R292" rMin="0*cm" rMax="2.92*cm" dz="1.5*cm" startPhi="0*deg" deltaPhi="360*deg" />
  <Tubs name="BCML1_Cut_R320" rMin="0*cm" rMax="3.2*cm" dz="1.5*cm" startPhi="0*deg" deltaPhi="360*deg" />
  <SubtractionSolid name="BCML1_SideShell">
    <rSolid name="BCML1_SideShellBase" />
    <rSolid name="BCML1_Cut_R284" />
    <Translation x="-3.15*cm" y="0*cm" z="0*cm" />
  </SubtractionSolid>
  <SubtractionSolid name="BCML1_SideCavity">
    <rSolid name="BCML1_SideCavityBase" />
    <rSolid name="BCML1_Cut_R292" />
    <Translation x="-3.075*cm" y="0*cm" z="0*cm" />
  </SubtractionSolid>
  <SubtractionSolid name="BCML1_Pcb">
    <rSolid name="BCML1_PcbBase" />
    <rSolid name="BCML1_Cut_R320" />
    <Translation x="-3.075*cm" y="0*cm" z="0*cm" />
  </SubtractionSolid>
  <SubtractionSolid name="BCML1_RailShell">
    <rSolid name="BCML1_RailBase" />
    <rSolid name="BCML1_Cut_R284" />
    <Translation x="-1.6*cm" y="0*cm" z="0*cm" />
  </SubtractionSolid>
  <SubtractionSolid name="BCML1_RailAir">
    <rSolid name="BCML1_RailAirBase" />
    <rSolid name="BCML1_Cut_R292" />
    <Translation x="-1.635*cm" y="0*cm" z="0*cm" />
  </SubtractionSolid>
</SolidSection>

