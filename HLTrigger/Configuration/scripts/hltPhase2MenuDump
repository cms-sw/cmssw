#!/usr/bin/env python3
"""
hltPhase2MenuDump -- inspect a configuration that contains the Phase-2 HLT menu.

Loads a cmsRun configuration (typically produced with
  cmsDriver.py Phase2 -s L1P2GT,HLT:75e33 ... --no_exec
), builds a model of the menu and writes it out as

  --list paths|modules|seeds|datasets|eventcontent   text listings (cf. hltListPaths,
                                                       getDatasets.py, getEventContent.py)
  --json FILE                                          machine-readable model
  -o DIR                                               browsable static HTML site
  --compare OTHER.json                                 add a diff against another dump
                                                       (e.g. default vs alpaka vs ticl_v5)

The HTML site has one page per path (ordered module chain, L1 seed, filter
parameters, products consumed but not scheduled), one page per module (type,
plugin source, cfi file, inputs, consumers, full python dump), plus pages for
EventSetup, services, outputs/datasets and menu-level checks.  It needs no
network access and no external assets.

Examples:
  hltPhase2MenuDump Phase2_L1P2GT_HLT.py --list paths
  hltPhase2MenuDump Phase2_L1P2GT_HLT.py -o html_default --json default.json
  hltPhase2MenuDump Phase2_Alpaka_L1P2GT_HLT.py -o html_alpaka --compare default.json
"""

import argparse
import hashlib
import html
import json
import os
import re
import runpy
import sys
from urllib.parse import quote_plus
from collections import OrderedDict, defaultdict

SCHEMA_VERSION = 1
MENU_SUBDIR = "HLTrigger/Configuration/python/HLT_75e33"
SEED_PARAMETERS = ("logicalExpression", "L1SeedsLogicalExpression")
PRESCALER_TYPES = ("HLTPrescaler",)
DATASET_FILTER_TYPES = ("TriggerResultsFilter",)

# ---------------------------------------------------------------------------
# loading
# ---------------------------------------------------------------------------


def load_process(cfg, cfg_args):
    """Execute a cmsRun configuration file and return its 'process' object."""
    cfg = os.path.abspath(cfg)
    saved_argv, saved_path = sys.argv, list(sys.path)
    sys.argv = [cfg] + list(cfg_args)
    sys.path.insert(0, os.path.dirname(cfg))
    try:
        namespace = runpy.run_path(cfg, run_name="__cfg__")
    finally:
        sys.argv, sys.path[:] = saved_argv, saved_path
    if "process" not in namespace:
        sys.exit("ERROR: %s does not define a 'process'" % cfg)
    return namespace["process"]


def _call(obj, name, default):
    fn = getattr(obj, name, None)
    if fn is None:
        return default
    try:
        return fn()
    except Exception:
        return default


def _type_name(x):
    return type(x).__name__


def collect_input_labels(pset_like, out):
    """Recursively collect module labels referenced through InputTag/VInputTag parameters."""
    params = _call(pset_like, "parameters_", None)
    if params is None:
        return
    for _name, value in params.items():
        _collect_value(value, out)


def _collect_value(value, out):
    t = _type_name(value)
    if t in ("InputTag", "untracked_InputTag") or hasattr(value, "getModuleLabel"):
        label = value.getModuleLabel()
        if label:
            out.add(label)
    elif t in ("VInputTag",):
        for item in value:
            if isinstance(item, str):
                label = item.split(":")[0]
                if label:
                    out.add(label)
            else:
                _collect_value(item, out)
    elif t in ("PSet", "untracked_PSet") or (hasattr(value, "parameters_") and not hasattr(value, "type_")):
        collect_input_labels(value, out)
    elif t in ("VPSet",):
        for item in value:
            collect_input_labels(item, out)


def scalar_parameters(module):
    """Top-level parameters with a short printable value (used to summarise filters)."""
    out = OrderedDict()
    params = _call(module, "parameters_", {}) or {}
    for name, value in params.items():
        t = _type_name(value)
        if t in ("PSet", "VPSet", "untracked_PSet"):
            continue
        try:
            text = value.dumpPython() if hasattr(value, "dumpPython") else repr(value)
        except Exception:
            text = repr(value)
        text = re.sub(r"\s+", " ", text).strip()
        if len(text) <= 160:
            out[name] = text
    return out


def string_parameter(module, names):
    params = _call(module, "parameters_", {}) or {}
    for n in names:
        if n in params:
            v = params[n]
            val = getattr(v, "value", lambda: v)()
            if isinstance(val, (list, tuple)):
                val = " or ".join(str(x) for x in val)
            return str(val)
    return None


class PathVisitor(object):
    """Visitor collecting module labels in a Path, in order, with Task/negation/ignore flags."""

    def __init__(self):
        self.entries = []
        self._stack = []

    def enter(self, visitee):
        cls = _type_name(visitee)
        label = _call(visitee, "label_", None) if hasattr(visitee, "type_") or "Switch" in cls else None
        if label and not cls.endswith("Task") and not cls.startswith("_Sequence") and cls not in ("Sequence",):
            flags = set(self._stack)
            self.entries.append({
                "label": label,
                "task": "task" in flags,
                "negated": "not" in flags,
                "ignored": "ignore" in flags,
            })
        if cls in ("Task", "ConditionalTask"):
            self._stack.append("task")
        elif "Negation" in cls:
            self._stack.append("not")
        elif "Ignore" in cls:
            self._stack.append("ignore")
        else:
            self._stack.append(None)

    def leave(self, visitee):
        if self._stack:
            self._stack.pop()


def path_entries(path):
    v = PathVisitor()
    path.visit(v)
    seen, out = set(), []
    for e in v.entries:          # a module can appear via several Tasks; keep the first occurrence
        if e["label"] not in seen:
            seen.add(e["label"])
            out.append(e)
    # Modules reachable only through Tasks may not be visited by Path.visit in every
    # release; moduleNames() includes them, so append whatever is still missing as task members.
    for label in sorted(_call(path, "moduleNames", set()) or set()):
        if label not in seen:
            seen.add(label)
            out.append({"label": label, "task": True, "negated": False, "ignored": False})
    return out


# ---------------------------------------------------------------------------
# model
# ---------------------------------------------------------------------------


def find_menu_dir():
    for var in ("CMSSW_BASE", "CMSSW_RELEASE_BASE"):
        base = os.environ.get(var)
        if base and os.path.isdir(os.path.join(base, "src", MENU_SUBDIR)):
            return os.path.join(base, "src", MENU_SUBDIR)
    return None


def build_model(process, cfg_name):
    menu_dir = find_menu_dir()
    kinds = OrderedDict([
        ("producer", _call(process, "producers_", {})),
        ("filter", _call(process, "filters_", {})),
        ("analyzer", _call(process, "analyzers_", {})),
        ("output", _call(process, "outputModules_", {})),
        ("switch", _call(process, "switchProducers_", {})),
    ])
    modules = OrderedDict()
    for kind, d in kinds.items():
        for label, mod in d.items():
            if kind == "switch":
                cases = sorted(_call(mod, "parameterNames_", []) or [])
                mtype = "SwitchProducer[%s]" % ",".join(cases)
            else:
                mtype = _call(mod, "type_", "?")
            try:
                py = mod.dumpPython()
            except Exception as e:  # pragma: no cover - defensive
                py = "# dumpPython failed: %s" % e
            inputs = set()
            collect_input_labels(mod, inputs)
            if kind == "switch":
                for case in _call(mod, "parameterNames_", []) or []:
                    collect_input_labels(getattr(mod, case), inputs)
            inputs.discard(label)
            cfi = None
            for sub in ("modules",):
                if menu_dir and os.path.isfile(os.path.join(menu_dir, sub, label + "_cfi.py")):
                    cfi = "%s/%s/%s_cfi.py" % (MENU_SUBDIR, sub, label)
            modules[label] = {
                "label": label,
                "kind": kind,
                "type": mtype,
                "inputs": sorted(inputs),
                "python": py,
                "hash": hashlib.sha1(py.encode()).hexdigest()[:12],
                "params": scalar_parameters(mod) if kind == "filter" else {},
                "seed": string_parameter(mod, SEED_PARAMETERS),
                "triggerConditions": (string_parameter(mod, ("triggerConditions",))
                                      if mtype in DATASET_FILTER_TYPES else None),
                "cfi": cfi,
            }

    # schedule order
    paths = _call(process, "paths_", {})
    endpaths = _call(process, "endpaths_", {})
    finalpaths = _call(process, "finalpaths_", {})
    schedule = _call(process, "schedule_", None)
    order = []
    if schedule is not None:
        try:
            order = [p.label_() for p in schedule]
        except Exception:
            order = []
    if not order:
        order = list(paths) + list(endpaths) + list(finalpaths)
    all_paths = OrderedDict()
    all_paths.update(paths)
    all_paths.update(endpaths)
    all_paths.update(finalpaths)

    path_model = OrderedDict()
    used_in = defaultdict(list)
    for name in order:
        if name not in all_paths:
            continue
        p = all_paths[name]
        kind = "path" if name in paths else ("endpath" if name in endpaths else "finalpath")
        entries = [e for e in path_entries(p) if e["label"] in modules]
        for e in entries:
            used_in[e["label"]].append(name)
        labels = {e["label"] for e in entries}
        seeds = [modules[e["label"]]["seed"] for e in entries if modules[e["label"]]["seed"]]
        filters = [e["label"] for e in entries if modules[e["label"]]["kind"] == "filter"
                   and modules[e["label"]]["type"] not in PRESCALER_TYPES and not e["task"]]
        unscheduled = sorted({i for e in entries for i in modules[e["label"]]["inputs"]
                              if i in modules and i not in labels})
        path_model[name] = {
            "name": name,
            "kind": kind,
            "modules": entries,
            "seed": " AND ".join(seeds) if seeds else None,
            "filters": filters,
            "last_filter": filters[-1] if filters else None,
            "consumed_not_in_path": unscheduled,
        }

    consumers = defaultdict(list)
    for label, m in modules.items():
        for i in m["inputs"]:
            if i in modules:
                consumers[i].append(label)
    for label, m in modules.items():
        m["used_in"] = used_in.get(label, [])
        m["consumers"] = sorted(consumers.get(label, []))
        m["external_inputs"] = [i for i in m["inputs"] if i not in modules]

    # datasets and event content
    datasets = OrderedDict()
    for name, p in path_model.items():
        for e in p["modules"]:
            m = modules[e["label"]]
            if m["triggerConditions"]:
                datasets[name] = {"filter": m["label"], "triggers": m["triggerConditions"]}
    outputs = OrderedDict()
    for label, m in modules.items():
        if m["kind"] != "output":
            continue
        mod = kinds["output"][label]
        commands, select = [], []
        try:
            commands = list(mod.outputCommands)
        except Exception:
            pass
        try:
            select = list(mod.SelectEvents.SelectEvents)
        except Exception:
            pass
        outputs[label] = {"type": m["type"], "outputCommands": [str(c) for c in commands],
                          "SelectEvents": [str(s) for s in select]}

    def es_dict(d):
        out = OrderedDict()
        for label, obj in d.items():
            out[label] = {"type": _call(obj, "type_", "?")}
        return out

    services = OrderedDict()
    for label, obj in (_call(process, "services_", {}) or {}).items():
        services[label] = {"type": _call(obj, "type_", label)}

    in_any_path = set(used_in)
    unused = [l for l, m in modules.items() if l not in in_any_path]
    return {
        "schema": SCHEMA_VERSION,
        "config": cfg_name,
        "process": _call(process, "name_", "?"),
        "release": os.environ.get("CMSSW_VERSION", "unknown"),
        "paths": path_model,
        "modules": modules,
        "datasets": datasets,
        "outputs": outputs,
        "es_producers": es_dict(_call(process, "es_producers_", {}) or {}),
        "es_sources": es_dict(_call(process, "es_sources_", {}) or {}),
        "services": services,
        "unused_modules": unused,
        "unscheduled_paths": [n for n in all_paths if n not in order],
    }


# ---------------------------------------------------------------------------
# comparison
# ---------------------------------------------------------------------------


def compare_models(new, old):
    np_, op_ = new["paths"], old["paths"]
    nm, om = new["modules"], old["modules"]
    diff = {
        "against": old.get("config", "?"),
        "paths_added": [p for p in np_ if p not in op_],
        "paths_removed": [p for p in op_ if p not in np_],
        "paths_changed": OrderedDict(),
        "modules_added": [m for m in nm if m not in om],
        "modules_removed": [m for m in om if m not in nm],
        "modules_changed": [],
    }
    for name in np_:
        if name not in op_:
            continue
        a = [e["label"] for e in np_[name]["modules"]]
        b = [e["label"] for e in op_[name]["modules"]]
        changed_cfg = [l for l in a if l in om and l in nm and om[l]["hash"] != nm[l]["hash"]]
        if a != b or changed_cfg or np_[name]["seed"] != op_[name]["seed"]:
            diff["paths_changed"][name] = {
                "added": [l for l in a if l not in b],
                "removed": [l for l in b if l not in a],
                "reordered": a != b and set(a) == set(b),
                "reconfigured": changed_cfg,
                "seed_old": op_[name]["seed"], "seed_new": np_[name]["seed"],
            }
    for l, m in nm.items():
        if l in om and om[l]["hash"] != m["hash"]:
            diff["modules_changed"].append({"label": l, "type_old": om[l]["type"], "type_new": m["type"]})
    return diff


# ---------------------------------------------------------------------------
# text listings
# ---------------------------------------------------------------------------


def print_list(model, what):
    if what == "paths":
        for name, p in model["paths"].items():
            print(name)
    elif what == "seeds":
        width = max([len(n) for n in model["paths"]] + [10])
        for name, p in model["paths"].items():
            if p["kind"] == "path":
                print("%-*s  %s" % (width, name, p["seed"] or "-"))
    elif what == "modules":
        for label, m in model["modules"].items():
            print("%-10s %-50s %s" % (m["kind"], m["type"], label))
    elif what == "datasets":
        if not model["datasets"]:
            print("# no TriggerResultsFilter-based datasets in this menu")
        for name, d in model["datasets"].items():
            print("%s: %s" % (name, d["triggers"]))
    elif what == "eventcontent":
        if not model["outputs"]:
            print("# no output modules in this configuration")
        for label, o in model["outputs"].items():
            print("# %s (%s)  SelectEvents=%s" % (label, o["type"], o["SelectEvents"] or "all"))
            for c in o["outputCommands"]:
                print("    " + c)


