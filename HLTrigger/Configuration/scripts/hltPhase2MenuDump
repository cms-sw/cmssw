JS = r"""
document.querySelectorAll('input[data-filter]').forEach(function(inp){
  var tbl=document.getElementById(inp.dataset.filter);
  var rows=tbl?tbl.tBodies[0].rows:[];
  var count=document.getElementById(inp.dataset.filter+'-count');
  inp.addEventListener('input',function(){
    var q=inp.value.trim().toLowerCase().split(/\s+/).filter(Boolean), n=0;
    for(var i=0;i<rows.length;i++){
      var t=rows[i].textContent.toLowerCase();
      var ok=q.every(function(w){return t.indexOf(w)>=0});
      rows[i].hidden=!ok; if(ok)n++;
    }
    if(count)count.textContent=n+' shown';
  });
});
document.querySelectorAll('table.sortable th').forEach(function(th){
  th.addEventListener('click',function(){
    var tbl=th.closest('table'), idx=[].indexOf.call(th.parentNode.children,th);
    var body=tbl.tBodies[0], rows=[].slice.call(body.rows);
    var dir=th.dataset.dir==='asc'?-1:1; th.dataset.dir=dir===1?'asc':'desc';
    rows.sort(function(a,b){
      var x=a.cells[idx].dataset.v||a.cells[idx].textContent, y=b.cells[idx].dataset.v||b.cells[idx].textContent;
      var nx=parseFloat(x), ny=parseFloat(y);
      if(!isNaN(nx)&&!isNaN(ny))return (nx-ny)*dir;
      return x.localeCompare(y)*dir;
    });
    rows.forEach(function(r){body.appendChild(r)});
  });
});
"""

KIND_CLASS = {"producer": "", "filter": "f", "analyzer": "a", "output": "o", "switch": ""}


def esc(s):
    return html.escape("" if s is None else str(s), quote=True)


def safe(name):
    return re.sub(r"[^A-Za-z0-9_.-]", "_", name)


class Site(object):
    NAV = [("index.html", "Paths"), ("modules.html", "Modules"), ("eventsetup.html", "EventSetup"),
           ("services.html", "Services"), ("outputs.html", "Outputs and datasets"), ("checks.html", "Checks")]

    def __init__(self, model, outdir, diff=None):
        self.m, self.out, self.diff = model, outdir, diff
        self.release = model["release"]
        self.nav = list(self.NAV) + ([("diff.html", "Differences")] if diff else [])

    # helpers -------------------------------------------------------------
    def rel(self, depth, target):
        return "../" * depth + target

    def mlink(self, label, depth):
        if label in self.m["modules"]:
            return '<a href="%s">%s</a>' % (self.rel(depth, "modules/%s.html" % safe(label)), esc(label))
        return '<span class="muted">%s</span>' % esc(label)

    def plink(self, name, depth):
        if name in self.m["paths"]:
            return '<a href="%s">%s</a>' % (self.rel(depth, "paths/%s.html" % safe(name)), esc(name))
        return esc(name)

    def kind(self, k):
        return '<span class="kind k-%s">%s</span>' % (esc(k), esc(k))

    def github_blob(self, relpath):
        ref = self.release if self.release.startswith("CMSSW_") else "master"
        return "https://github.com/cms-sw/cmssw/blob/%s/%s" % (ref, relpath)

    def plugin_search(self, mtype):
        base = re.sub(r"^SwitchProducer\[.*\]$", "SwitchProducer", mtype.split("@")[0])
        return "https://github.com/search?type=code&q=" + quote_plus("repo:cms-sw/cmssw " + base)

    def page(self, relpath, title, body, here=None):
        depth = relpath.count("/")
        nav = "".join('<a href="%s"%s>%s</a>' % (self.rel(depth, href), ' class="here"' if href == here else "",
                                                   esc(text)) for href, text in self.nav)
        sub = "%s, process %s, %d paths, %d modules" % (
            self.release, self.m["process"],
            sum(1 for p in self.m["paths"].values() if p["kind"] == "path"), len(self.m["modules"]))
        doc = """<!DOCTYPE html>
<html lang="en"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>%s</title><link rel="stylesheet" href="%s"></head>
<body><header><p class="menu">Phase-2 HLT menu</p><p class="sub">%s, from <code>%s</code></p>
<nav>%s</nav></header><main>%s
<footer>Generated by hltPhase2MenuDump.</footer></main>
<script src="%s"></script></body></html>
""" % (esc(title), self.rel(depth, "style.css"), esc(sub), esc(self.m["config"]), nav, body,
            self.rel(depth, "menu.js"))
        path = os.path.join(self.out, relpath)
        os.makedirs(os.path.dirname(path), exist_ok=True)
        with open(path, "w") as f:
            f.write(doc)

    def table(self, tid, headers, rows, search_hint=None):
        h = ""
        if search_hint:
            h += ('<input class="search" type="search" data-filter="%s" placeholder="%s" aria-label="%s"> '
                  '<span class="muted" id="%s-count">%d shown</span>' % (tid, esc(search_hint), esc(search_hint),
                                                                       tid, len(rows)))
        h += '<div class="scroll"><table class="sortable" id="%s"><thead><tr>%s</tr></thead><tbody>' % (
            tid, "".join("<th>%s</th>" % esc(x) for x in headers))
        for r in rows:
            h += "<tr>%s</tr>" % "".join(c if c.startswith("<td") else "<td>%s</td>" % c for c in r)
        return h + "</tbody></table></div>"

    # pages ---------------------------------------------------------------
    def write(self):
        os.makedirs(self.out, exist_ok=True)
        with open(os.path.join(self.out, "style.css"), "w") as f:
            f.write(CSS)
        with open(os.path.join(self.out, "menu.js"), "w") as f:
            f.write(JS)
        self.index()
        self.modules_index()
        for name in self.m["paths"]:
            self.path_page(name)
        for label in self.m["modules"]:
            self.module_page(label)
        self.eventsetup()
        self.services()
        self.outputs()
        self.checks()
        if self.diff:
            self.diff_page()

    def index(self):
        changed = self.diff["paths_changed"] if self.diff else {}
        added = set(self.diff["paths_added"]) if self.diff else set()
        rows = []
        for i, (name, p) in enumerate(self.m["paths"].items(), 1):
            mark = ""
            if name in added:
                mark = ' <span class="add">new</span>'
            elif name in changed:
                mark = ' <a class="warn" href="diff.html#%s">changed</a>' % safe(name)
            rows.append([
                '<td class="num">%d</td>' % i,
                self.plink(name, 0) + mark,
                esc(p["kind"]),
                "<code>%s</code>" % esc(p["seed"]) if p["seed"] else '<span class="muted">none</span>',
                '<td class="num">%d</td>' % len(p["modules"]),
                '<td class="num">%d</td>' % len(p["filters"]),
                self.mlink(p["last_filter"], 0) if p["last_filter"] else "",
            ])
        body = ("<h1>Paths</h1><p class=\"lead\">All paths and end paths in schedule order. "
                "Click a column header to sort; type to filter by path, seed or filter name.</p>")
        body += self.table("paths", ["#", "Path", "Kind", "L1 seed", "Modules", "Filters", "Last filter"],
                           rows, "Filter paths")
        self.page("index.html", "Phase-2 HLT paths", body, "index.html")

    def modules_index(self):
        rows = []
        for label, m in self.m["modules"].items():
            rows.append([self.mlink(label, 0), self.kind(m["kind"]), "<code>%s</code>" % esc(m["type"]),
                         '<td class="num">%d</td>' % len(m["used_in"]),
                         '<td class="num">%d</td>' % len(m["consumers"])])
        body = "<h1>Modules</h1><p class=\"lead\">Every EDProducer, EDFilter, EDAnalyzer and output module in the configuration.</p>"
        body += self.table("modules", ["Label", "Kind", "Plugin type", "Paths", "Consumers"], rows, "Filter modules")
        self.page("modules.html", "Modules", body, "modules.html")

    def path_page(self, name):
        p = self.m["paths"][name]
        mods = self.m["modules"]
        body = "<h1>%s</h1>" % esc(name)
        body += '<dl class="facts"><dt>Kind</dt><dd>%s</dd><dt>Modules</dt><dd>%d (%d in tasks)</dd>' \
                '<dt>Filters</dt><dd>%d</dd></dl>' % (esc(p["kind"]), len(p["modules"]),
                                                      sum(e["task"] for e in p["modules"]), len(p["filters"]))
        if p["seed"]:
            body += '<div class="seed"><strong>L1 seed</strong><br><code>%s</code></div>' % esc(p["seed"])
        body += ("<h2>Module sequence</h2><p class=\"legend\">Diamonds are filters that can reject the event; "
                 "dashed circles run on demand from a Task; open circles are producers.</p><ol class=\"chain\">")
        for e in p["modules"]:
            m = mods[e["label"]]
            cls = "t" if e["task"] else KIND_CLASS.get(m["kind"], "")
            flags = []
            if e["negated"]:
                flags.append("negated")
            if e["ignored"]:
                flags.append("ignored")
            if e["task"]:
                flags.append("task")
            body += '<li class="%s"><span class="dot"></span><span class="name">%s</span>' \
                    '<span class="type">%s%s</span>' % (cls, self.mlink(e["label"], 1), esc(m["type"]),
                                                         (" (" + ", ".join(flags) + ")") if flags else "")
            if m["kind"] == "filter" and m["params"] and not e["task"]:
                body += "<details><summary>Selection parameters</summary><table>"
                for k, v in m["params"].items():
                    body += "<tr><td>%s</td><td><code>%s</code></td></tr>" % (esc(k), esc(v))
                body += "</table></details>"
            body += "</li>"
        body += "</ol>"
        if p["consumed_not_in_path"]:
            body += ("<h2>Consumed but not in this path</h2><p class=\"lead\">Products read by modules of this path "
                     "whose producers are neither in the path nor in one of its Tasks. They run only if scheduled "
                     "elsewhere (another path or a schedule Task); otherwise the product is missing.</p><ul class=\"cols\">")
            body += "".join("<li>%s</li>" % self.mlink(l, 1) for l in p["consumed_not_in_path"]) + "</ul>"
        self.page("paths/%s.html" % safe(name), name, body)

    def module_page(self, label):
        m = self.m["modules"][label]
        body = "<h1>%s</h1>" % esc(label)
        body += '<dl class="facts"><dt>Kind</dt><dd>%s</dd><dt>Plugin type</dt><dd><code>%s</code> ' \
                '(<a href="%s">find plugin source</a>)</dd>' % (self.kind(m["kind"]), esc(m["type"]),
                                                               self.plugin_search(m["type"]))
        if m["cfi"]:
            body += '<dt>Configuration</dt><dd><a href="%s"><code>%s</code></a></dd>' % (
                self.github_blob(m["cfi"]), esc(m["cfi"]))
        if m["seed"]:
            body += "<dt>L1 seed</dt><dd><code>%s</code></dd>" % esc(m["seed"])
        body += "</dl>"
        body += "<h2>Used in %d paths</h2>" % len(m["used_in"])
        body += ('<ul class="cols">%s</ul>' % "".join("<li>%s</li>" % self.plink(p, 1) for p in m["used_in"])
                 if m["used_in"] else '<p class="muted">Not in any path. It runs only if a schedule Task or another '
                                      'module pulls it in.</p>')
        body += "<h2>Inputs</h2>"
        if m["inputs"]:
            body += '<ul class="cols">%s</ul>' % "".join(
                "<li>%s%s</li>" % (self.mlink(i, 1), "" if i in self.m["modules"] else
                                   ' <span class="muted">(input file or earlier process)</span>')
                for i in m["inputs"])
        else:
            body += '<p class="muted">No InputTag parameters.</p>'
        body += "<h2>Consumed by</h2>"
        body += ('<ul class="cols">%s</ul>' % "".join("<li>%s</li>" % self.mlink(c, 1) for c in m["consumers"])
                 if m["consumers"] else '<p class="muted">No module in this configuration reads it.</p>')
        body += "<h2>Configuration dump</h2><pre>%s = %s</pre>" % (esc(label), esc(m["python"]))
        self.page("modules/%s.html" % safe(label), label, body)

    def eventsetup(self):
        rows = [[esc(l), "ESProducer", "<code>%s</code>" % esc(d["type"])] for l, d in self.m["es_producers"].items()]
        rows += [[esc(l), "ESSource", "<code>%s</code>" % esc(d["type"])] for l, d in self.m["es_sources"].items()]
        body = "<h1>EventSetup</h1>" + self.table("es", ["Label", "Kind", "Type"], rows, "Filter EventSetup modules")
        self.page("eventsetup.html", "EventSetup", body, "eventsetup.html")

    def services(self):
        rows = [[esc(l), "<code>%s</code>" % esc(d["type"])] for l, d in self.m["services"].items()]
        body = "<h1>Services</h1>" + self.table("svc", ["Label", "Type"], rows)
        self.page("services.html", "Services", body, "services.html")

    def outputs(self):
        body = "<h1>Outputs and datasets</h1>"
        body += "<h2>Datasets</h2>"
        if self.m["datasets"]:
            rows = [[self.plink(n, 0), self.mlink(d["filter"], 0), "<code>%s</code>" % esc(d["triggers"])]
                    for n, d in self.m["datasets"].items()]
            body += self.table("ds", ["Dataset path", "Filter", "Trigger conditions"], rows)
        else:
            body += '<p class="muted">No dataset paths (TriggerResultsFilter) in this configuration.</p>'
        body += "<h2>Output modules</h2>"
        if not self.m["outputs"]:
            body += '<p class="muted">No output modules. Re-run cmsDriver with --eventcontent to add one.</p>'
        for label, o in self.m["outputs"].items():
            body += "<h2>%s</h2><p>%s, selects %s</p><pre>%s</pre>" % (
                esc(label), esc(o["type"]), esc(", ".join(o["SelectEvents"]) or "all events"),
                esc("\n".join(o["outputCommands"])))
        self.page("outputs.html", "Outputs and datasets", body, "outputs.html")

    def checks(self):
        body = "<h1>Checks</h1><p class=\"lead\">Menu-level findings from the loaded configuration. " \
               "Static file checks are done by hltPhase2MenuCheck.</p>"
        body += "<h2>Modules in no path (%d)</h2>" % len(self.m["unused_modules"])
        body += ('<p class="lead">Includes modules that only run from schedule Tasks, and leftovers from other steps '
                 'of the configuration (L1, validation).</p><ul class="cols">%s</ul>'
                 % "".join("<li>%s</li>" % self.mlink(l, 0) for l in self.m["unused_modules"])
                 if self.m["unused_modules"] else '<p class="muted">None.</p>')
        missing = [(n, p["consumed_not_in_path"]) for n, p in self.m["paths"].items() if p["consumed_not_in_path"]]
        body += "<h2>Paths consuming products they do not schedule (%d)</h2>" % len(missing)
        if missing:
            rows = [[self.plink(n, 0), '<td class="num">%d</td>' % len(l),
                     ", ".join(self.mlink(x, 0) for x in l[:8]) + (" ..." if len(l) > 8 else "")] for n, l in missing]
            body += self.table("cons", ["Path", "Count", "Producers"], rows, "Filter")
        else:
            body += '<p class="muted">None.</p>'
        unsched = self.m.get("unscheduled_paths", [])
        body += "<h2>Paths defined but not in the schedule (%d)</h2>" % len(unsched)
        body += ('<p class="lead">cmsRun will not run these.</p><ul class="cols">%s</ul>'
                 % "".join("<li>%s</li>" % esc(n) for n in unsched) if unsched else '<p class="muted">None.</p>')
        seedless = [n for n, p in self.m["paths"].items() if p["kind"] == "path" and not p["seed"]]
        body += "<h2>Paths without an L1 seed module (%d)</h2>" % len(seedless)
        body += ('<ul class="cols">%s</ul>' % "".join("<li>%s</li>" % self.plink(n, 0) for n in seedless)
                 if seedless else '<p class="muted">None.</p>')
        self.page("checks.html", "Checks", body, "checks.html")

    def diff_page(self):
        d = self.diff
        body = "<h1>Differences</h1><p class=\"lead\">This menu compared with <code>%s</code>.</p>" % esc(d["against"])

        def lst(title, items, cls, linker):
            out = "<h2>%s (%d)</h2>" % (esc(title), len(items))
            if items:
                out += '<ul class="cols">%s</ul>' % "".join('<li class="%s">%s</li>' % (cls, linker(i)) for i in items)
            return out
        body += lst("Paths added", d["paths_added"], "add", lambda n: self.plink(n, 0))
        body += lst("Paths removed", d["paths_removed"], "rem", esc)
        body += "<h2>Paths changed (%d)</h2>" % len(d["paths_changed"])
        for name, c in d["paths_changed"].items():
            body += '<h2 id="%s">%s</h2><ul class="plain">' % (safe(name), self.plink(name, 0))
            if c["seed_old"] != c["seed_new"]:
                body += "<li>L1 seed: <code>%s</code> became <code>%s</code></li>" % (esc(c["seed_old"]), esc(c["seed_new"]))
            for l in c["added"]:
                body += '<li class="add">added %s</li>' % self.mlink(l, 0)
            for l in c["removed"]:
                body += '<li class="rem">removed %s</li>' % esc(l)
            if c["reordered"]:
                body += "<li>same modules, different order</li>"
            for l in c["reconfigured"]:
                body += "<li>reconfigured %s</li>" % self.mlink(l, 0)
            body += "</ul>"
        body += lst("Modules added", d["modules_added"], "add", lambda n: self.mlink(n, 0))
        body += lst("Modules removed", d["modules_removed"], "rem", esc)
        rows = [[self.mlink(c["label"], 0), "<code>%s</code>" % esc(c["type_old"]),
                 "<code>%s</code>" % esc(c["type_new"])] for c in d["modules_changed"]]
        body += "<h2>Modules reconfigured (%d)</h2>" % len(rows)
        if rows:
            body += self.table("mc", ["Module", "Type before", "Type now"], rows, "Filter")
        self.page("diff.html", "Differences", body, "diff.html")


# ---------------------------------------------------------------------------


def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("config", help="cmsRun configuration (python) containing the HLT menu, "
                                       "or a JSON file written by a previous --json")
    parser.add_argument("-o", "--output-dir", help="write a static HTML site to this directory")
    parser.add_argument("--json", metavar="FILE", help="write the menu model as JSON")
    parser.add_argument("--list", choices=["paths", "modules", "seeds", "datasets", "eventcontent"],
                        help="print a text listing to stdout")
    parser.add_argument("--compare", metavar="JSON", help="JSON dump of another menu to diff against")
    parser.add_argument("--hlt-only", action="store_true",
                        help="keep only paths whose name starts with HLT_, DST_, MC_ or Dataset_ (drops L1 paths)")
    parser.epilog = "Arguments after a lone '--' are passed to the configuration as sys.argv."
    argv = list(sys.argv[1:] if argv is None else argv)
    cfg_args = []
    if "--" in argv:
        cut = argv.index("--")
        argv, cfg_args = argv[:cut], argv[cut + 1:]
    args = parser.parse_args(argv)

    if args.config.endswith(".json"):
        with open(args.config) as f:
            model = json.load(f)
    else:
        model = build_model(load_process(args.config, cfg_args), os.path.basename(args.config))

    if args.hlt_only:
        keep = ("HLT_", "DST_", "MC_", "Dataset_", "HLTriggerFinal", "HLTAnalyzerEndpath")
        model["paths"] = OrderedDict((n, p) for n, p in model["paths"].items()
                                     if n.startswith(keep) or p["kind"] != "path")
        in_paths = {e["label"] for p in model["paths"].values() for e in p["modules"]}
        for label, m in model["modules"].items():
            m["used_in"] = [p for p in m["used_in"] if p in model["paths"]]
        model["unused_modules"] = [l for l in model["modules"] if l not in in_paths]

    diff = None
    if args.compare:
        with open(args.compare) as f:
            diff = compare_models(model, json.load(f))

    if args.json:
        with open(args.json, "w") as f:
            json.dump(model, f, indent=1)
    if args.list:
        print_list(model, args.list)
    if args.output_dir:
        Site(model, args.output_dir, diff).write()
        print("hltPhase2MenuDump: wrote %s/index.html (%d paths, %d modules)"
              % (args.output_dir, len(model["paths"]), len(model["modules"])), file=sys.stderr)
    if not (args.json or args.list or args.output_dir):
        print_list(model, "paths")
    return 0


if __name__ == "__main__":
    sys.exit(main())
