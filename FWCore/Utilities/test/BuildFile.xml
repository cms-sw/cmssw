<use name="boost"/>
<use name="FWCore/Utilities"/>

<test name="TestHelper_t" command="${value}.sh" foreach="testFriendlyNames,testAdler32"/>

<bin file="typedefs_t.cpp">
  <flags NO_TESTRUN="1"/>
</bin>

<bin file="test_catch2HRTime.cc,test_catch2_main.cc" name="testFWCoreUtilitiesHRTime">
  <use name="catch2"/>
</bin>

<bin file="test_catch2Slow_cputimer.cc,test_catch2_main.cc" name="testFWCoreUtilitiesCPUTimer">
  <use name="catch2"/>
</bin>

<bin file="test_catch2_*.cc" name="testFWCoreUtilitiesCatch2">
  <use name="catch2"/>
</bin>

<!-- -->
<bin file="test_catch2FileInPath.cc" name="testFWCoreUtilitiesFileInPath">
  <use name="catch2"/>
  <flags NO_TESTRUN="1"/>
</bin>

<!--
  "noData", "absolutePath" and "symlinkAssert" are deliberately not in this
  list: each has only [hang]-tagged test case(s) (see
  test_catch2FileInPath.cc), so with the default "~[hang]" filter Catch2
  finds zero matching tests and exits with its "no tests ran" code. They
  can still be run manually, e.g.:
    testFWCoreUtilitiesFileInPath noData
  with an explicit "[hang]" filter added in main(), under `timeout`.
-->
<test name="TestFWCoreUtilitiesFileInPath"
      command="testFWCoreUtilitiesFileInPath ${value}"
      foreach="local,noRelease,sameTops,symlink,emptySearchPath,lookupDisabled,emptyPathElement,noData,absolutePath">
  <flags PRE_TEST="testFWCoreUtilitiesFileInPath"/>
</test>

<bin file="InputTag_t.cpp">
  <use name="tbb"/>
</bin>

<bin file="RunningAverage_t.cpp">
  <use name="tbb"/>
</bin>
